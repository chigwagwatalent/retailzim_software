[Unit]
Description=RetailZim Java 21 backend
After=network-online.target
Wants=network-online.target

[Service]
User=retailzw
Group=retailzw
WorkingDirectory=/opt/retailzw
EnvironmentFile=/etc/retailzw/retailzw.env
ExecStart=/bin/sh /opt/retailzw/start.sh
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/retailzw/uploads /opt/retailzw/logs

[Install]
WantedBy=multi-user.target
