SPRING_PROFILES_ACTIVE=prod
PORT=8080
APP_BASE_URL=https://admin.retailzw.co.zw

# Release uploads: Nginx uses 350 MB transport headroom while the application
# validates and stores release packages up to 300 MB.
RETAILZW_MULTIPART_MAX_FILE_SIZE=300MB
RETAILZW_MULTIPART_MAX_REQUEST_SIZE=310MB
RETAILZW_RELEASE_MAX_FILE_SIZE_BYTES=314572800
RETAILZW_RELEASE_UPLOAD_DIR=/var/lib/retailzw/releases

DB_URL=jdbc:mysql://127.0.0.1:3306/retail_zw?useSSL=true&serverTimezone=Africa/Harare
DB_USERNAME=retailzw_app
DB_PASSWORD=replace-with-a-strong-database-password

MAIL_HOST=mail.retailzw.co.zw
MAIL_PORT=587
MAIL_FROM_NAME=RetailZW
MAIL_SUPPORT_FROM=support@retailzw.co.zw
MAIL_SUPPORT_PASSWORD=replace-with-support-mailbox-password
MAIL_BILLING_FROM=sales@retailzw.co.zw
MAIL_BILLING_PASSWORD=replace-with-sales-mailbox-password
MAIL_NOTIFICATIONS_FROM=info@retailzw.co.zw
MAIL_NOTIFICATIONS_PASSWORD=replace-with-info-mailbox-password
MAIL_REPLY_TO=support@retailzw.co.zw

JWT_SECRET=replace-with-at-least-64-random-characters
SMILEPAY_API_KEY=replace-with-production-api-key
SMILEPAY_API_SECRET=replace-with-production-api-secret
